# Auto-install peers declared in dependencies
auto-install-peers=true
# Don't fail on unresolvable peer deps (overridable per-package)
strict-peer-dependencies=false
# Keep strict workspace isolation (don't hoist to root)
shamefully-hoist=false
# Save exact versions for workspace-protocol deps to keep lockfile deterministic
save-workspace-protocol=rolling

# Changesets publish registry
default-registry=https://registry.npmjs.org/
publish-registry=https://registry.npmjs.org/