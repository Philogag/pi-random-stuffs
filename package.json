{
  "name": "pi-ramdom-stuffs",
  "version": "0.0.0",
  "private": true,
  "description": "Node.js monorepo (pnpm workspaces + TypeScript)",
  "type": "module",
  "packageManager": "pnpm@11.1.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm -r --parallel build",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r test:unit",
    "lint": "pnpm -r lint",
    "typecheck": "sh -c 'if [ -n \"$(find packages -mindepth 2 -maxdepth 2 -name tsconfig.json 2>/dev/null)\" ]; then tsc -b; else echo \"no packages to typecheck yet\"; fi'",
    "clean": "pnpm -r exec rm -rf dist .turbo *.tsbuildinfo",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "3.0.1",
    "typescript": "^5.6.3"
  }
}