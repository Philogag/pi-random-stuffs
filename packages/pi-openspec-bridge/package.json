{
  "name": "@philogag/pi-openspec-bridge",
  "version": "0.1.0",
  "description": "pi extension: openspec CLI bridge tool + openspec status bar",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "pi": {
    "extensions": ["dist/index.js"]
  },
  "files": ["dist"],
  "keywords": ["pi", "extension", "openspec", "tool", "tui"],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "lint": "echo \"no linter configured\""
  },
  "dependencies": {
    "@fission-ai/openspec": "^1.15.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "@earendil-works/pi-tui": "^0.84.4",
    "typebox": "^1.3.19",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Philogag/pi-random-stuffs"
  }
}
