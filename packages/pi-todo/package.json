{
  "name": "@philogag/pi-todo",
  "version": "0.1.0",
  "description": "pi extension: a self-managed todo list for the model — 5-state task graph, live overlay, and bounded stop-time reminders",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "pi": {
    "extensions": [
      "dist/index.js"
    ]
  },
  "files": [
    "dist",
    "docs"
  ],
  "keywords": [
    "pi",
    "extension",
    "todo",
    "tasks",
    "reminder",
    "overlay"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "lint": "echo \"no linter configured\""
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": ">=0.87.0",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.4.0",
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@earendil-works/pi-tui": "^1.4.0",
    "typebox": "^1.3.19",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Philogag/pi-random-stuffs",
    "directory": "packages/pi-todo"
  },
  "license": "MIT"
}
