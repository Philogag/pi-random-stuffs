{
  "name": "@philogag/pi-tool-presistant-bash",
  "version": "0.1.1",
  "description": "pi extension: manage long-lived bash sessions for the agent",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "pi": {
    "extensions": ["dist/index.js"]
  },
  "files": ["dist"],
  "keywords": ["pi", "extension", "bash", "session", "persistent"],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "lint": "echo \"no linter configured\""
  },
  "dependencies": {},
  "optionalDependencies": {
    "@philogag/pi-tui-fold-blocks": "workspace:*"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@philogag/pi-tui-fold-blocks": "workspace:*",
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "typebox": "^1.3.19",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Philogag/pi-random-stuffs"
  }
}
