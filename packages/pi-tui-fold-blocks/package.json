{
  "name": "@philogag/pi-tui-fold-blocks",
  "version": "0.3.0",
  "description": "pi extension: fold tool call block into one line in tui",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "pi": {
    "extensions": [
      "dist/index.js"
    ]
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "pi",
    "extension",
    "tui",
    "tool-blocks"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "lint": "echo \"no linter configured\"",
    "smoke": "node scripts/smoke-click.mjs",
    "smoke:openspec": "node scripts/smoke-openspec.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@earendil-works/pi-tui": "^1.4.0",
    "typebox": "^1.3.19",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Philogag/pi-random-stuffs"
  }
}